# Server port and address (localhost only by default — there is no authentication!)
HUBNESS_PORT=8787
HUBNESS_HOST=127.0.0.1
# Where to keep the database and logs (./.data by default)
# HUBNESS_DATA_DIR=/home/me/.local/share/hubness
# Agent binaries (harness). Logins and models live in their own settings.
# HUBNESS_CLAUDE_BIN=claude
# HUBNESS_OPENCODE_BIN=opencode
# HUBNESS_GROK_BIN=grok
# Codex ACP adapter (version is pinned; Codex login — ~/.codex/auth.json or CODEX_API_KEY)
# HUBNESS_CODEX_ACP=npx -y @zed-industries/codex-acp@0.16.0
# Hub working folder: inbox (new chats), projects, home (system project)
# HUBNESS_HOME=/home/me/hub
# Encryption key for project secrets (string of >= 32 characters; several comma-separated —
# the first encrypts, the rest only decrypt: rotate the key without losing secrets).
# Not set — a key is generated in <data>/secret.key (mode 600); store it apart from DB backups.
# HUBNESS_SECRET_KEY=
# Preview proxy ports (Run → Preview), on the same address as the hub
# HUBNESS_PREVIEW_PORTS=8790-8809
# Rust server only (crates/server): the built web app to serve. Default: the copy compiled
# into hubcli (feature embed-web, as release builds have it), else ./apps/web/dist
# HUBNESS_WEB_DIST=/opt/hubness/web
# Rust server only (crates/server): sign-in uses hub accounts, not a setting. A non-loopback
# HUBNESS_HOST is refused until an account exists: create one with `hubcli user add <name>`.
# The hub speaks plain HTTP: across untrusted networks put it behind an HTTPS reverse proxy
# or a VPN.

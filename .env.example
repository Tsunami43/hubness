# Порт и адрес сервера (по умолчанию только localhost — авторизации нет!)
HUBNESS_PORT=8787
HUBNESS_HOST=127.0.0.1
# Где хранить БД и логи (по умолчанию ./.data)
# HUBNESS_DATA_DIR=/home/me/.local/share/hubness
# Бинари агентов (harness). Логины и модели — в их собственных настройках.
# HUBNESS_CLAUDE_BIN=claude
# HUBNESS_OPENCODE_BIN=opencode
# HUBNESS_GROK_BIN=grok
# ACP-адаптер Codex (версия запинена; логин Codex — ~/.codex/auth.json или CODEX_API_KEY)
# HUBNESS_CODEX_ACP=npx -y @zed-industries/codex-acp@0.16.0
# Рабочая папка хаба: inbox (новые чаты), projects, home (системный проект)
# HUBNESS_HOME=/home/me/hub
# Ключ шифрования секретов проектов (строка ≥ 32 символов; несколько через запятую —
# первым шифруем, остальными только читаем: смена ключа без потери секретов).
# Не задан — ключ генерируется в <data>/secret.key (права 600); храните его отдельно от бэкапа БД.
# HUBNESS_SECRET_KEY=
# Порты прокси превью (Run → Preview), на том же адресе, что и хаб
# HUBNESS_PREVIEW_PORTS=8790-8809

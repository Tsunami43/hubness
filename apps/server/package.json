{
  "name": "@hubness/server",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/dev.ts",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning src/index.ts",

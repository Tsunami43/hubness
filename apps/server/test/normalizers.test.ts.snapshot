exports[`acp (codex): chunks, permission auto-allowed in bypass, tool output, diff edit, plan 1`] = `
{
  "agentSessionId": "acp-sess-1",
  "statuses": [],
  "events": [
    {
      "kind": "thinking",
      "text": "Need to look at the file.",
      "uid": "th#1"
    },
    {
      "kind": "text",
      "text": "Let me edit it.",
      "streaming": false,
      "uid": "t#1"
    },
    {
      "kind": "tool",
      "toolId": "call_1",
      "name": "Bash",
      "input": {
        "command": "cat notes.txt"
      },
      "status": "ok",
      "output": "hello",
      "uid": "tool#1"
    },
    {
      "kind": "tool",
      "toolId": "call_2",
      "name": "Edit",
      "input": {
        "file_path": "/work/notes.txt",
        "old_string": "hello",
        "new_string": "hello world"
      },
      "status": "ok",
      "output": "diff /work/notes.txt",
      "uid": "tool#2"
    },
    {
      "kind": "tool",
      "toolId": "plan:<run>",
      "name": "TodoWrite",
      "input": {
        "todos": [
          {
            "content": "Read notes",
            "status": "completed"
          },
          {
            "content": "Edit notes",
            "status": "completed"
          }
        ]
      },
      "status": "ok",
      "uid": "plan#1"
    },
    {
      "kind": "text",
      "text": "Done: notes.txt now says hello world.",
      "streaming": false,
      "uid": "t#2"
    },
    {
      "kind": "result",
      "ok": true,
      "model": "provider/model-a",
      "uid": "res#1"
    }
  ]
}
`;

